{
  "manifestVersion": 2,
  "id": "opencode-quota",
  "name": "OpenCode 额度",
  "version": "0.2.5",
  "description": "一页看完 OpenCode Go 和 Command Code 的额度用量与重置倒计时，不用再登录网页。",
  "entry": "index.js",
  "capabilities": [
    "app/tools.expose-to-model"
  ],
  "network": {
    "allowedHosts": [
      "opencode.ai",
      "api.commandcode.ai"
    ],
    "methods": [
      "GET"
    ],
    "defaultTimeoutMs": 15000,
    "maxResponseBytes": 65536
  },
  "contributes": {
    "settings": {
      "title": "OpenCode 额度",
      "schema": {
        "properties": {
          "apiKey": {
            "type": "string",
            "title": "OpenCode API key",
            "description": "在 opencode.ai 后台建的 key，只需要额度读取权限。",
            "default": "",
            "scope": "global",
            "sensitive": true
          },
          "commandCodeKey": {
            "type": "string",
            "title": "Command Code API key",
            "description": "commandcode.ai 的 key，通常以 user_ 开头。留空则不显示这一段的额度。",
            "default": "",
            "scope": "global",
            "sensitive": true
          },
          "warnPercent": {
            "type": "integer",
            "title": "转黄阈值 (%)",
            "description": "用量到这个百分比开始提醒。",
            "default": 70,
            "scope": "global"
          },
          "dangerPercent": {
            "type": "integer",
            "title": "转红阈值 (%)",
            "description": "用量到这个百分比算危险。",
            "default": 90,
            "scope": "global"
          }
        }
      }
    },
    "cards": [
      {
        "id": "panel",
        "title": "OpenCode 额度",
        "description": "OpenCode 与 Command Code 的额度用量，上下排列。",
        "route": "/panel.html",
        "face": {
          "image": "assets/cover.svg"
        }
      }
    ],
    "ui": {
      "messageActions": [
        {
          "id": "quota",
          "title": "查额度",
          "messages": "assistant",
          "toolName": "opencode_quota"
        }
      ]
    }
  },
  "icon": "assets/icon.svg",
  "minAppVersion": "1.1.35-beta"
}
